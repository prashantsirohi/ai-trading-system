{
  "policy_version": "jcurve-agent-policy-v1",
  "transport": "OPENROUTER_CHAT_COMPLETIONS_V1",
  "base_url": "https://openrouter.ai/api/v1",
  "models": {
    "text_extractor": "deepseek/deepseek-chat",
    "vision_extractor": "google/gemini-2.5-flash-lite",
    "vision_fallback": "qwen/qwen2.5-vl-72b-instruct",
    "text_verifier": "google/gemini-2.5-flash-lite",
    "vision_verifier": "deepseek/deepseek-chat"
  },
  "allowed_provider_slugs": [],
  "extraction_prompt_version": "jcurve-extractor-v1",
  "verification_prompt_version": "jcurve-verifier-v1",
  "max_context_characters": 18000,
  "max_pages_per_request": 8,
  "max_output_tokens": 1600,
  "max_retries": 1,
  "max_requests_per_run": 500,
  "halt_new_requests_at_reported_cost_usd": 25.0,
  "temperature": 0,
  "full_document_prompting_forbidden": true,
  "require_structured_outputs": true,
  "require_different_verifier_family": true,
  "persist_reasoning_trace": false
}
