    "BUILD": "WATCHLIST",
    "CAPEX_VISIBLE_UNCLASSIFIED": "MANUAL_TRIAGE",
    "NOT_SELECTED": "DROP",
    "HISTORY_UNAVAILABLE": "DATA_GAP"
  },
  "primary_queue": {
    "limit": 250,
    "eligible_dispositions": ["RAMP_ACTIVE", "COMMISSIONING"],
    "disposition_order": ["RAMP_ACTIVE", "COMMISSIONING"],
    "tie_break_order": ["SCREEN_MATCH_COUNT_DESC", "RAMP_SCREEN_MATCH_DESC", "COMMISSIONING_SCREEN_MATCH_DESC", "ISIN_ASC"],
    "overflow_disposition": "WATCHLIST_OVERFLOW"
  },
  "authority": "DISCOVERY_ONLY_OFFICIAL_FILINGS_REQUIRED"
