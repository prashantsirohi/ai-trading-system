{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jcurve-claim-batch-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_type", "evidence_state", "numeric_value", "boolean_value",
          "text_value", "unit", "project_name", "project_location",
          "exact_excerpt", "page", "effective_at", "confidence"
        ],
        "properties": {
          "claim_type": {
            "enum": [
              "CAPEX_ANNOUNCED", "CAPEX_AMOUNT", "CAPEX_UNDER_CONSTRUCTION", "CAPEX_COMPLETED",
              "PLANT_COMMISSIONED", "COMMERCIAL_PRODUCTION_STARTED",
              "CAPACITY_OLD", "CAPACITY_NEW", "CAPACITY_INCREMENT",
              "UTILISATION_REPORTED", "CUSTOMER_QUALIFIED",
              "COMMERCIAL_SUPPLY_STARTED", "DEMAND_PATH_REPORTED",
              "EXPECTED_INCREMENTAL_REVENUE", "CAPEX_DELAYED", "CAPEX_CANCELLED"
            ]
          },
          "evidence_state": {"enum": ["PRESENT", "NOT_DISCLOSED"]},
          "numeric_value": {"type": ["number", "null"]},
          "boolean_value": {"type": ["boolean", "null"]},
          "text_value": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "project_name": {"type": ["string", "null"]},
          "project_location": {"type": ["string", "null"]},
          "exact_excerpt": {"type": ["string", "null"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "effective_at": {"type": ["string", "null"], "format": "date-time"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
