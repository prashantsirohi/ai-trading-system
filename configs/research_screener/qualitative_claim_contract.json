{
  "contract_version": "1.0.0",
  "claim_schema_version": "qualitative-claim-v1",
  "review_schema_version": "qualitative-claim-review-v1",
  "structured_output_schemas": {
    "extraction": "configs/research_screener/schemas/qualitative_claim_v1.schema.json",
    "verification": "configs/research_screener/schemas/qualitative_claim_review_v1.schema.json"
  },
  "allowed_topics": [
    "governance",
    "shareholding",
    "business_kpi",
    "capex_capacity",
    "order_book",
    "management_guidance"
  ],
  "claim_kinds": [
    "ACTUAL",
    "TARGET",
    "GUIDANCE",
    "ASPIRATION",
    "RISK",
    "GOVERNANCE_FACT",
    "OWNERSHIP_FACT",
    "KPI_DEFINITION"
  ],
  "materiality_levels": ["LOW", "MEDIUM", "HIGH"],
  "review_decisions": ["ACCEPT", "REJECT", "AMBIGUOUS"],
  "claim_statuses": [
    "AGENT_EXTRACTED",
    "AGENT_VERIFIED",
    "AGENT_REJECTED",
    "CONFLICT_DETECTED",
    "HUMAN_REVIEW_REQUIRED",
    "HUMAN_VERIFIED"
  ],
  "evidence_states_not_materialized_as_claims": ["NOT_DISCLOSED", "SOURCE_UNAVAILABLE"],
  "required_claim_fields": [
    "claim_id",
    "schema_version",
    "research_run_id",
    "document_id",
    "company_id",
    "security_id",
    "isin",
    "company_type",
    "topic",
    "metric_name",
    "claim_kind",
    "claim_text",
    "exact_excerpt",
    "page",
    "source_artifact_id",
    "source_content_hash",
    "published_at",
    "fiscal_period",
    "statement_scope",
    "materiality",
    "extraction_model",
    "extraction_prompt_version"
  ],
  "high_impact_topics": ["governance", "shareholding", "management_guidance"],
  "high_impact_claim_kinds": ["TARGET", "GUIDANCE", "GOVERNANCE_FACT", "OWNERSHIP_FACT"],
  "automatic_acceptance": {
    "required_extraction_decision": "ACCEPT",
    "required_verification_decision": "ACCEPT",
    "require_independent_verifier_context": true,
    "require_same_normalized_claim": true,
    "block_high_materiality": true,
    "block_high_impact_topics": true,
    "block_conflicts": true
  },
  "low_cost_agent_policy": {
    "transport": "OPENAI_BATCH_API",
    "completion_window": "24h",
    "primary_model": "gpt-4o-mini-2024-07-18",
    "extraction_prompt_version": "qualitative-extractor-v1",
    "verification_prompt_version": "qualitative-verifier-v1",
    "structured_outputs_required": true,
    "full_document_prompting_forbidden": true,
    "context_policy": "CITED_PAGE_PLUS_ONE_ADJACENT_PAGE_EACH_SIDE",
    "max_context_characters": 18000,
    "max_extraction_output_tokens": 800,
    "max_verification_output_tokens": 500,
    "max_claims_per_packet": 5,
    "max_packets_per_company": 6,
    "max_retries_per_request": 1,
    "calibration_company_count": 25,
    "calibration_input_token_budget": 1500000,
    "calibration_output_token_budget": 400000,
    "halt_new_requests_at_budget_fraction": 0.9,
    "verification_only_for_deterministically_valid_claims": true,
    "deterministic_deduplication_before_agent": true,
    "independent_verifier_request": true,
    "reasoning_trace_persistence_forbidden": true,
    "model_escalation_enabled": false,
    "model_escalation_target": null,
    "exception_route": "HUMAN_REVIEW_REQUIRED",
    "usage_fields": [
      "input_tokens",
      "cached_input_tokens",
      "output_tokens",
      "request_id",
      "batch_id"
    ]
  }
}
